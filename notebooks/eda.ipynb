    "# Part 2\n",
    "\n",
    "print(\"Missing Geometry:\")\n",
    "print(sum(f.get(\"geometry\") is None for f in features))\n",
    "\n",
    "print(\"\\nDuplicate Features:\")\n",
    "print(len(features) - len({\n",
